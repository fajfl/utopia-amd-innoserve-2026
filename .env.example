# Copy to .env. Supply your own credentials; never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
WEB_URL=http://localhost:3000
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LIFF_ID=
LINE_MINIAPP_SECRET=
LINE_OA_BASIC_ID=

# Local synthetic demo only. Configure a separate database for deployment.
V2_DB_DRIVER=sqlite
V2_DATABASE_PATH=data/ecs-neo-v2.sqlite
APP_DATABASE_PATH=data/app.sqlite
FILE_STORAGE_PROVIDER=local
V2_CONTRACT_EVIDENCE_DIR=./uploads/contract-evidence
ENABLE_LINE_TEST_COMMANDS=false
ALLOW_TEST_LINE_IDENTITY=false
ENABLE_DEMO_OTP=false
LANDLORD_KNOWLEDGE_DEMO_ENABLED=false
LANDLORD_REPORT_DEMO_ENABLED=false

# AMD competition profile: vLLM endpoint from AMD-ITRI Lab; put the real URL only in your local .env.
AI_PROVIDER=vllm
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=http://<lab-host>:<port>/v1
AI_API_KEY=not-needed
AI_ENABLE_JSON_SCHEMA=true
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=300000

ECS_NEO_AGENT_ENABLED=false
AGENT_RUNTIME_URL=http://127.0.0.1:8000
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8000
AGENT_RUNTIME_SHARED_SECRET=
AGENT_RUNTIME_TIMEOUT_MS=20000
PRE_INSPECTION_TOKEN_SECRET=
