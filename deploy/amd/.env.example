# Fill on the Linux GPU host; do not commit the resulting .env.
# Select an image version/digest compatible with the actual GPU and ROCm driver.
VLLM_IMAGE=
LLAMACPP_IMAGE=
INFERENCE_API_KEY=
SERVED_MODEL_NAME=ecsneo-model
CONTEXT_SIZE=8192
# vLLM: choose licensed, supported weights; deepseek-flash is not a weights path.
MODEL_ID=
HF_TOKEN=
TENSOR_PARALLEL_SIZE=1
# llama.cpp: existing GGUF files on the GPU host, mounted read-only.
MODEL_DIR=
GGUF_FILE=
